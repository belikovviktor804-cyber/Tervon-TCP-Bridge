+  Future<void> _toggleBypass(bool enable) async {
+    if (_busy) return;
+    setState(() { _busy = true; _message = 'Проверка Bridge…'; });
+    try {
+      String? url;
+      if (enable) {
+        url = await XrayService.getActiveSubscriptionRaw();
+        final parsed = Uri.tryParse(url ?? '');
+        if (parsed == null || parsed.scheme != 'https' || parsed.host.isEmpty ||
+            parsed.userInfo.isNotEmpty) {
+          if (mounted) setState(() => _message = 'Нет выбранной HTTPS-подписки для автоматической регистрации');
+          return;
+        }
+      }
+      final data = await _channel.invokeMapMethod<String, dynamic>(
+        'setBypassEnabled', {'enabled': enable, if (url != null) 'subscriptionUrl': url});
+      if (!mounted) return;
+      final state = data?['state']?.toString() ?? 'UNKNOWN';
+      setState(() {
+        _enabled = data?['enabled'] == true;
+        _message = switch (state) {
+          'DISABLED' => 'Обход DPI выключен',
+          'ENROLLED' => 'Сертификат Bridge получен. Переключение VPN ещё не подключено.',
+          'REUSED' => 'Действующий сертификат Bridge найден. Переключение VPN ещё не подключено.',
+          'NO_BRIDGE' => 'На сервере текущей подписки Bridge отсутствует',
+          'CANCELLED' => 'Регистрация отменена',
+          _ => 'Неизвестный результат регистрации Bridge',
+        };
+      });
+    } on PlatformException catch (e) {
+      if (mounted) setState(() { _enabled = false; _message = 'Автоматическая регистрация: ${e.code}'; });
+    } catch (_) {
+      if (mounted) setState(() { _enabled = false; _message = 'Автоматическая регистрация Bridge не выполнена'; });
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
