# PROPOSED ONLY — do not apply to running nginx without operator approval.
# Insert both locations inside the EXISTING stats.xrayvless.online HTTPS
# server {}. Do not replace any existing /admin or /infrastructure location.
# Replace the placeholder with the EXACT auth_basic_user_file value already
# used by /admin/ on the host. Do not publish that path or file contents.
# No new authentication database or credentials are needed.

location = /bridge {
    auth_basic "Tervon Bridge monitoring";
    auth_basic_user_file __EXISTING_ADMIN_HTPASSWD_FILE__;
    return 308 /bridge/;
}

location ^~ /bridge/ {
    auth_basic "Tervon Bridge monitoring";
    auth_basic_user_file __EXISTING_ADMIN_HTPASSWD_FILE__;

    # Upstream must be a separately started, loopback-only Bridge dashboard
    # service, NOT the existing infrastructure app on port 8893.
    proxy_pass http://127.0.0.1:8894;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 2s;
    proxy_read_timeout 5s;
    proxy_send_timeout 5s;

    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
}
