# PROPOSED ONLY — do not apply before isolated stats service NEW_SERVICE=PASS.
# Operator decision (2026-11-17): public read-only Bridge dashboard,
# no HTTP Basic Auth for /bridge or /bridge/.
# Keep existing /admin/ authentication and /infrastructure/ unchanged.
# Insert both locations inside the EXISTING stats.xrayvless.online HTTPS
# server {} after an nginx config audit and with backup + rollback.

location = /bridge {
    auth_basic off;
    limit_except GET { deny all; }
    proxy_pass http://127.0.0.1:8894/bridge/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 2s;
    proxy_read_timeout 5s;
    proxy_send_timeout 5s;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
}

location ^~ /bridge/ {
    auth_basic off;
    limit_except GET { deny all; }
    # Local, sandboxed, separate service; never proxy raw /metrics/v1.
    proxy_pass http://127.0.0.1:8894;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 2s;
    proxy_read_timeout 5s;
    proxy_send_timeout 5s;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
}
