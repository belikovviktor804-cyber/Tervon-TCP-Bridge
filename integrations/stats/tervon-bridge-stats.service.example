# STAGING TEMPLATE — do not enable without operator approval.
# Install application files read-only in /opt/tervon/bridge-stats
# after checking directory permissions and existing service names.
[Unit]
Description=Tervon TCP Bridge Homeserver-only stats dashboard
Documentation=https://github.com/tervon-software/Tervon-TCP-Bridge
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/tervon/bridge-stats
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/tervon/bridge-stats.env
ExecStart=/opt/xray-blocker/web-dashboard/venv/bin/uvicorn bridge_site:app --host 127.0.0.1 --port 8894 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s

# Only localhost network access (nginx->dashboard, dashboard->local Bridge).
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
